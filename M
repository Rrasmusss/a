local function createFeatureToggle(parentTab, text, posY, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 32)
	btn.Position = UDim2.new(0, 0, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	btn.Text = text .. " : OFF"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.Parent = tabs[parentTab]
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn
	
	local active = false
	btn.MouseButton1Click:Connect(function()
		active = not active
		btn.Text = active and (text .. " : ON") or (text .. " : OFF")
		btn.BackgroundColor3 = active and Color3.fromRGB(40, 160, 60) or Color3.fromRGB(180, 40, 40)
		callback(active)
	end)
end

