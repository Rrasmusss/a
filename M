local tabButtons = {}
local function createTabElement(name, posY)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -10, 0, 30)
	btn.Position = UDim2.new(0, 5, 0, posY)
	btn.BackgroundColor3 = (name == runtimeConfig.CurrentTab) and Color3.fromRGB(25, 25, 30) or Color3.fromRGB(15, 15, 18)
	btn.Text = name
	btn.TextColor3 = (name == runtimeConfig.CurrentTab) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 145)
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 12
	btn.BorderSizePixel = 0
	btn.Parent = navFrame
	
	btn.MouseButton1Click:Connect(function()
		runtimeConfig.CurrentTab = name
		for tName, tFrame in pairs(tabs) do
			tFrame.Visible = (tName == name)
			tabButtons[tName].BackgroundColor3 = (tName == name) and Color3.fromRGB(25, 25, 30) or Color3.fromRGB(15, 15, 18)
			tabButtons[tName].TextColor3 = (tName == name) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(140, 140, 145)
		end
	end)
	tabButtons[name] = btn
end
