-- Button Hover & Toggle Transitions
local function toggleVisuals(btn, state)
    local targetColor = state and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(150, 150, 150)
    local targetBg = state and Color3.fromRGB(40, 50, 45) or Color3.fromRGB(30, 30, 30)
    
    TweenService:Create(btn, TweenInfo.new(0.2), {TextColor3 = targetColor, BackgroundColor3 = targetBg}):Play()
end

OrbitButton.MouseButton1Click:Connect(function()
    orbitEnabled = not orbitEnabled
    OrbitButton.Text = "Orbit + VoidSpam: " .. (orbitEnabled and "ON" or "OFF")
    toggleVisuals(OrbitButton, orbitEnabled)
end)

AutoShootButton.MouseButton1Click:Connect(function()
    autoShootEnabled = not autoShootEnabled
    AutoShootButton.Text = "Auto Shoot: " .. (autoShootEnabled and "ON" or "OFF")
    toggleVisuals(AutoShootButton, autoShootEnabled)
end)

-- 2. DRAGGABLE: Smooth GUI Drag System
local dragging, dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- 3. CORE LOGIC: Orbit, VoidSpam & Shooting Vector
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
            if player.Character.Humanoid.Health > 0 then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = player
                end
            end
        end
    end
    return closestPlayer
end

local function isTargetVisible(targetPart)
    local _, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
    return onScreen
end

local function simulateClick()
    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    end
end

local loopConnection
loopConnection = RunService.Heartbeat:Connect(function(deltaTime)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    local rootPart = LocalPlayer.Character.HumanoidRootPart
    local target = getClosestPlayer()

    if orbitEnabled and target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local targetRoot = target.Character.HumanoidRootPart
        angle = angle + (ORBIT_SPEED * deltaTime)
        local offset = Vector3.new(math.cos(angle) * ORBIT_RADIUS, 0, math.sin(angle) * ORBIT_RADIUS)
        
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.CFrame = CFrame.new(targetRoot.Position + offset, targetRoot.Position)
    end

    if autoShootEnabled and target and target.Character and target.Character:FindFirstChild("Head") then
        if isTargetVisible(target.Character.Head) then
            simulateClick()
        end
    end
end)

-- 4. EJECTABLE: Instantly stop all loops and clear memory
EjectButton.MouseButton1Click:Connect(function()
    orbitEnabled = false
    autoShootEnabled = false
    if loopConnection then loopConnection:Disconnect() end
    ScreenGui:Destroy()
end)
