-- Make sure Rayfield UI Library is loaded
local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source"))()

local Window = Rayfield:CreateWindow({
    Name = "Dead Rails Bonds Shop",
    LoadingTitle = "Dead Rails Bonds Shop",
    LoadingSubtitle = "by YourName",
    ConfigurationSaving = {Enabled = false}
})

-- Helper to create item selectors
local function createItemSection(tab, sectionName, items)
    local section = tab:CreateSection(sectionName)
    for _, item in ipairs(items) do
        section:CreateDropdown({
            Name = "Select Quantity for " .. item,
            Options = {"1", "2", "3", "4", "5"},
            CurrentOption = "1",
            Callback = function(quantity)
                Rayfield:Notify({
                    Title = "Selection",
                    Content = "You chose to buy " .. quantity .. "x " .. item,
                    Duration = 5
                })
            end
        })
    end
end

-- General Store Tab
